  "$id": "https://example.invalid/quality-security-gate/consolidated-report.schema.json",
  "title": "Quality Security Gate consolidated report v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plugin_version",
    "snapshot",
    "risk",
    "required_gates",
    "modules",
    "verdict",
    "investigator_tasks",
    "global_failures"
