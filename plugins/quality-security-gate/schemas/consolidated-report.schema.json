    "plugin_version": {
      "const": "0.2.0"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "fingerprint",
        "instructions"
      ],
      "properties": {
        "root": {
          "type": "string",
          "pattern": "^/"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "instructions": {
          "type": "array"
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "factors"
      ],
      "properties": {
        "profile": {
          "enum": [
            "P1",
            "P2",
            "P3"
          ]
        },
        "factors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "required_gates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^GATE-00[1-5]$"
      }
    },
    "modules": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "prefixItems": [
