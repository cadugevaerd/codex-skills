{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/inject_context.py\"",
            "commandWindows": "py -3 \"%PLUGIN_ROOT%\\hooks\\inject_context.py\"",
            "timeout": 5,
            "additionalContextLimit": 5000
          }
        ]
      }
    ]
  }
}
